"""Environment variables for Business Card Organizer Backend."""

# Security
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql://appuser:password@postgres:5432/business_card_organizer

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Environment
ENVIRONMENT=development

# CORS
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Rate limiting
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_CONTACT_CREATE=10